# DeepSeek API (https://platform.deepseek.com)
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# Free tier: generations per IP per day
DAILY_FREE_LIMIT=3

# Supabase (Settings -> API Keys)
# Leave empty to use the in-memory rate limiter
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Waffo Pancake (server-only — never expose the private key)
WAFFO_MERCHANT_ID=
WAFFO_STORE_ID=
WAFFO_PRIVATE_KEY=
WAFFO_ENV=prod
